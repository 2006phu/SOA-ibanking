# iBanking Tuition Payment System - Environment Variables

# PostgreSQL
POSTGRES_USER=ibanking
POSTGRES_PASSWORD=ibanking_secret_2026
POSTGRES_HOST=postgres

# Database names (one per service)
AUTH_DB_NAME=auth_db
USER_DB_NAME=user_db
TUITION_DB_NAME=tuition_db
PAYMENT_DB_NAME=payment_db
OTP_DB_NAME=otp_db

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=ibanking
RABBITMQ_PASSWORD=rabbitmq_secret_2026
RABBITMQ_MANAGEMENT_PORT=15672

# JWT
JWT_SECRET_KEY=ibanking-jwt-super-secret-key-2026-tdtu
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# OTP
OTP_EXPIRATION_MINUTES=5
OTP_LENGTH=6

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=iBanking TDTU

# Service URLs (internal Docker network)
AUTH_SERVICE_URL=http://auth-service:8001
USER_SERVICE_URL=http://user-service:8002
TUITION_SERVICE_URL=http://tuition-service:8003
PAYMENT_SERVICE_URL=http://payment-service:8004
OTP_SERVICE_URL=http://otp-service:8005
NOTIFICATION_SERVICE_URL=http://notification-service:8006

# Frontend
REACT_APP_API_URL=http://localhost:8000/api
